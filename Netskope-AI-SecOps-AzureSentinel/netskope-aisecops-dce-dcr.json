{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Name of the existing Log Analytics workspace that will receive AI SecOps events. No default - the deployment asks for it."
      }
    },
    "workspaceResourceGroup": {
      "type": "string",
      "metadata": {
        "description": "Resource group that contains the Log Analytics workspace. May differ from the resource group this template is deployed into. No default - the deployment asks for it."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for the DCE and DCR. Must match the Log Analytics workspace region. Fetch it with: az monitor log-analytics workspace show --resource-group <ws-rg> --workspace-name <ws> --query location -o tsv"
      }
    },
    "dceName": {
      "type": "string",
      "defaultValue": "dce-netskope-aisecops",
      "metadata": {
        "description": "Name of the data collection endpoint to create."
      }
    },
    "dcrName": {
      "type": "string",
      "defaultValue": "dcr-netskope-aisecops",
      "metadata": {
        "description": "Name of the data collection rule to create."
      }
    }
  },
  "variables": {
    "workspaceResourceId": "[resourceId(parameters('workspaceResourceGroup'), 'Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "netskope-aisecops-table",
      "resourceGroup": "[parameters('workspaceResourceGroup')]",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "outer"
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces/tables",
              "apiVersion": "2022-10-01",
              "name": "[format('{0}/NetskopeAISecOps_CL', parameters('workspaceName'))]",
              "properties": {
                "plan": "Analytics",
                "schema": {
                  "name": "NetskopeAISecOps_CL",
                  "columns": [
                    {
                      "name": "TimeGenerated",
                      "type": "datetime",
                      "description": "Envelope delivery timestamp"
                    },
                    {
                      "name": "EventType",
                      "type": "string",
                      "description": "Envelope: event type discriminator (case.created, risk.ai_app.scored, ...)"
                    },
                    {
                      "name": "NetskopeTenantId",
                      "type": "string",
                      "description": "Envelope: Netskope tenant identifier (TenantId is reserved, hence the prefix)"
                    },
                    {
                      "name": "Region",
                      "type": "string",
                      "description": "Envelope: Netskope region"
                    },
                    {
                      "name": "ApiVersion",
                      "type": "string",
                      "description": "Envelope: AISecOps event schema version"
                    },
                    {
                      "name": "Data",
                      "type": "dynamic",
                      "description": "Full AISecOps event payload; parse fields at query time via the NetskopeAISecOpsEvents function"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2021-04-01",
      "name": "[parameters('dceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dcrName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "netskope-aisecops-table",
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dceName'))]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dceName'))]",
        "streamDeclarations": {
          "Custom-NetskopeAISecOps_CL": {
            "columns": [
              {
                "name": "timestamp",
                "type": "datetime"
              },
              {
                "name": "tenant_id",
                "type": "string"
              },
              {
                "name": "region",
                "type": "string"
              },
              {
                "name": "api_version",
                "type": "string"
              },
              {
                "name": "type",
                "type": "string"
              },
              {
                "name": "data",
                "type": "dynamic"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[variables('workspaceResourceId')]",
              "name": "laDestination"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-NetskopeAISecOps_CL"
            ],
            "destinations": [
              "laDestination"
            ],
            "transformKql": "source | project ['TimeGenerated'] = ['timestamp'], ['EventType'] = ['type'], ['NetskopeTenantId'] = ['tenant_id'], ['Region'] = ['region'], ['ApiVersion'] = ['api_version'], ['Data'] = ['data']",
            "outputStream": "Custom-NetskopeAISecOps_CL"
          }
        ]
      }
    }
  ],
  "outputs": {
    "destinationUrl": {
      "type": "string",
      "value": "[format('{0}/dataCollectionRules/{1}/streams/Custom-NetskopeAISecOps_CL?api-version=2023-01-01', reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dceName')), '2021-04-01').logsIngestion.endpoint, reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName')), '2023-03-11').immutableId)]"
    },
    "dcrImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName')), '2023-03-11').immutableId]"
    },
    "dceLogsIngestionEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dceName')), '2021-04-01').logsIngestion.endpoint]"
    },
    "dcrResourceIdForRoleAssignment": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName'))]"
    },
    "workspaceResourceId": {
      "type": "string",
      "value": "[variables('workspaceResourceId')]"
    }
  }
}

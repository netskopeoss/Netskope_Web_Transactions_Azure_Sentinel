// NetskopeAISecOpsEvents - query-time parser for NetskopeAISecOps_CL
// Save this query as a Log Analytics function named: NetskopeAISecOpsEvents
// (Logs > run this query > Save > Save as function)
// Usage examples:
//   NetskopeAISecOpsEvents | where EventType == "case.created"
//   NetskopeAISecOpsEvents | where Band == "critical"
//   NetskopeAISecOpsEvents | where isnotempty(McpServerId)
NetskopeAISecOps_CL
| extend d = Data
| extend
    // Best event time: created_at, else scored_at, else delivery time
    EventTime = coalesce(todatetime(d.created_at), todatetime(d.scored_at), TimeGenerated),
    // Cases - core
    CaseId = tostring(d.case_id),
    EventTitle = tostring(d.title),
    Severity = tostring(d.severity),
    RuleIds = d.rule_ids,
    Url = tostring(d.url),
    User = tostring(d.user),
    EntityType = tostring(d.entity_type),
    CreatedAt = todatetime(d.created_at),
    Status = tostring(d.status),
    OldStatus = tostring(d.old_status),
    NewStatus = tostring(d.new_status),
    ChangedBy = tostring(d.changed_by),
    Assignee = tostring(d.assignee),
    AssignedBy = tostring(d.assigned_by),
    InvestigationError = tostring(d.error),
    AlertCount = toint(d.alert_count),
    IncidentCount = toint(d.incident_count),
    DataSources = d.data_sources,
    AssignedTo = tostring(d.assigned_to),
    GroupId = tostring(d.group_id),
    ViewId = tostring(d.view_id),
    CreationSource = tostring(d.creation_source),
    ClosureRecommendation = tostring(d.closure_recommendation),
    // Cases - investigation enrichment
    Verdict = tostring(d.verdict),
    Summary = tostring(d.summary),
    SummaryMarkdown = tostring(d.summary_markdown),
    RiskScore = toint(d.risk_score),
    RiskFactors = d.risk_factors,
    RecommendedActions = d.recommended_actions,
    DataConfidence = d.data_confidence,
    UserContext = d.user_context,
    DataExposure = d.data_exposure,
    IncidentsSummary = d.incidents_summary,
    Entities = d.entities,
    KeyEvidence = d.key_evidence,
    FileLineage = d.file_lineage,
    // Risk - entity identity (one family populated per event)
    UserId = tostring(d.user_id),
    UserName = tostring(d.user_name),
    AppId = tostring(d.app_id),
    AppName = tostring(d.app_name),
    McpServerId = tostring(d.mcp_server_id),
    McpServerName = tostring(d.mcp_server_name),
    // Risk - scoring
    Score = toint(d.score),
    Band = tostring(d.band),
    PreviousBand = tostring(d.previous_band),
    PreviousUci = toint(d.previous_uci),
    RiskNote = tostring(d.risk_note),
    RiskIndicators = d.risk_indicators,
    PrimaryDriver = tostring(d.primary_driver),
    CategorySubscores = d.category_subscores,
    ScoredAt = todatetime(d.scored_at)
| project-away d
